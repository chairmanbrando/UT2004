//==============================================================================
//  What health chargers hold in CoD Mode: a mini health vial at twice the
//  size, healing 15 and overhealing as vials do.
//==============================================================================

class CoDHealthVial extends MiniHealthPack;

defaultproperties
{
    HealingAmount=15
    MaxDesireability=0.5
    DrawScale=0.12
    CollisionRadius=32.0
}
